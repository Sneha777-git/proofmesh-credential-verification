# ProofMesh environment template — placeholders only. Never commit real values.
# This app runs on TanStack Start: browser-visible variables use VITE_ (the equivalent of
# NEXT_PUBLIC_*). Everything without VITE_ is server-only and read inside server handlers.

# --- Browser-safe (public) ---
VITE_SUPABASE_URL=https://your-project.example.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000   # or use src/lib/web3/deployment.json
VITE_CHAIN_ID=11155111
# VITE_SEPOLIA_PUBLIC_RPC=https://ethereum-sepolia-rpc.publicnode.com

# --- Server-only ---
SUPABASE_URL=https://your-project.example.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=        # managed by the platform; never expose
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-key
PINATA_JWT=your-pinata-jwt
N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/proofmesh
N8N_WEBHOOK_SECRET=long-random-shared-secret

# --- Contract deployment only (your shell, never the app) ---
# DEPLOYER_PRIVATE_KEY=              # testnet-only wallet; never commit, never set in the app
