# ProofMesh environment template — placeholders only. Never commit real values.
# This app runs on TanStack Start, so browser-visible variables use the VITE_ prefix
# (the equivalent of NEXT_PUBLIC_* in the original brief).

# Browser-safe (publishable) values
VITE_SUPABASE_URL=https://your-project.example.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only (read inside server functions via process.env; never prefix with VITE_)
SUPABASE_URL=https://your-project.example.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=   # managed by the platform; never expose to the browser

# Future phases (server-only)
# SEPOLIA_RPC_URL=
# PROOFMESH_CONTRACT_ADDRESS=
# IPFS_API_TOKEN=
# N8N_WEBHOOK_SECRET=
